    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.0.0",
    "ts-loader": "^9.4.3",
